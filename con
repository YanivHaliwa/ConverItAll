def main():
    """Main conversion logic"""
    # Check for special flags first (before argument count validation)
    if len(sys.argv) > 1:
        if sys.argv[1] in ['-h', '--help', 'help']:
            show_help()
            sys.exit(0)

    # Now check argument count for actual conversion - show full help
    if len(sys.argv) == 1:
        show_help()
        sys.exit(0)
    if len(sys.argv) == 2:
        show_help()
        sys.exit(1)

    source_path = sys.argv[1]
    target_format = sys.argv[2].lower().lstrip('.')

    # Validate source file
    if not os.path.exists(source_path):
        print(f"❌ Error: Source file '{source_path}' not found")
        sys.exit(1)

    source = Path(source_path).resolve()
    source_ext = source.suffix.lower().lstrip('.')

    # Determine file categories
    source_category, source_ext_actual = get_file_category(source_ext, source.name)
    target_category, target_ext_actual = get_file_category(target_format, target_format)

    # Use actual detected extension if found
    if source_ext_actual:
        source_ext = source_ext_actual
    if target_ext_actual:
        target_format = target_ext_actual

    if not source_category:
        print(f"❌ Error: Unsupported source format '.{source_ext}'")
        print("Run 'con --help' to see supported formats")
        sys.exit(1)

    if not target_category:
        print(f"❌ Error: Unsupported target format '.{target_format}'")
        print("Run 'con --help' to see supported formats")
        sys.exit(1)

    # Prevent same-format conversion
    if source_ext == target_format:
        print(f"⚠️  Source and target formats are the same (.{source_ext})")
        sys.exit(0)

    print(f"🔄 Converting: {source.name} → .{target_format}")

    # Route to appropriate converter
    success = False
    error_msg = None

    # Special handling for PDF source files (using markitdown with Hebrew fixing)
    if source_ext == 'pdf' and target_format in ['md', 'txt', 'html']:
        success, result = convert_pdf(source, target_format, source_ext)
    # Same category conversions
    elif source_category == 'document' and target_category == 'document':
        success, result = convert_document(source, target_format, source_ext)
    elif source_category == 'image' and target_category == 'image':
        success, result = convert_image(source, target_format, source_ext)
    elif source_category == 'audio' and target_category == 'audio':
        success, result = convert_audio(source, target_format, source_ext)
    elif source_category == 'video' and target_category == 'video':
        success, result = convert_video(source, target_format, source_ext)
    elif source_category == 'archive' and target_category == 'archive':
        success, result = convert_archive(source, target_format, source_ext)
    elif source_category == 'data' and target_category == 'data':
        success, result = convert_data(source, target_format, source_ext)

    # Cross-category conversions
    elif source_category == 'document' and target_category == 'image':
        success, result = convert_document_to_image(
            source,
            target_format,
            source_ext,
            pdf_all_pages=(source_ext == 'pdf')
        )
    elif source_category == 'image' and target_category == 'document':
        success, result = convert_image_to_document(source, target_format, source_ext)
    elif source_category == 'video' and target_category == 'audio':
        success, result = convert_video(source, target_format, source_ext)
    elif source_category == 'video' and target_category == 'image' and target_format == 'gif':
        success, result = convert_video_to_gif(source, target_format, source_ext)
    elif source_category == 'data' and target_category == 'document' and target_format == 'csv':
        success, result = convert_data(source, target_format, source_ext)
    elif source_category == 'document' and source_ext == 'csv' and target_category == 'data':
        success, result = convert_data(source, target_format, source_ext)
    elif source_category == 'document' and source_ext in ['xlsx', 'xls', 'ods'] and target_category == 'data':
        # Excel to data formats: convert to CSV first, then to target data format
        print(f"⏳ Converting spreadsheet to CSV first...")
        csv_success, csv_result = convert_document(source, 'csv', source_ext)
        if csv_success:
            success, result = convert_data(Path(csv_result), target_format, 'csv')
            Path(csv_result).unlink(missing_ok=True)
        else:
            success, result = False, "Failed to convert spreadsheet to CSV"
    elif source_category == 'data' and target_category == 'document' and target_format in ['xlsx', 'xls', 'ods']:
        # Data formats to Excel: convert to CSV first, then to target Excel format
        print(f"⏳ Converting data to CSV first...")
        csv_temp = source.with_suffix('.temp.csv')
        csv_success, csv_result = convert_data(source, 'csv', source_ext)
        if csv_success:
            success, result = convert_document(Path(csv_result), target_format, 'csv')
            Path(csv_result).unlink(missing_ok=True)
        else:
            success, result = False, "Failed to convert data to CSV"

    # Unsupported cross-category conversions
    else:
        error_msg = f"Cannot convert {source_category} to {target_category}"

    if success:
        print(f"✅ Converted successfully: {result}")
        sys.exit(0)
    else:
        print(f"❌ Conversion failed: {result if not error_msg else error_msg}")
        sys.exit(1)

