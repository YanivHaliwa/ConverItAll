def check_tool_available(tool):
    """Check if a tool is available in the system"""
    return shutil.which(tool) is not None

def get_pdf_page_output_dir(source):
    """Return the output directory used for multi-page PDF image exports."""
    output_dir = source.parent / source.stem
    if output_dir.exists() and not output_dir.is_dir():
        raise RuntimeError(f"Output path exists and is not a folder: {output_dir}")
    output_dir.mkdir(exist_ok=True)
    return output_dir

def get_page_number_from_path(path):
    """Extract the numeric page suffix from a pdftoppm-generated filename."""
    try:
        return int(path.stem.rsplit('-', 1)[-1])
    except (IndexError, ValueError):
        return 0

def get_png_dimensions(path):
    """Read width and height directly from a PNG header."""
    with path.open('rb') as f:
        header = f.read(24)
    if header[:8] != b'\x89PNG\r\n\x1a\n':
        raise ValueError(f"Not a PNG file: {path}")
    width, height = struct.unpack('>II', header[16:24])
    return width, height

def write_embedded_svg_from_png(source_png, output_svg):
    """Create an SVG file that embeds the rendered PNG page as a data URI."""
    width, height = get_png_dimensions(source_png)
    png_base64 = base64.b64encode(source_png.read_bytes()).decode('ascii')
    svg_content = f"""<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" viewBox="0 0 {width} {height}">
  <image width="{width}" height="{height}" href="data:image/png;base64,{png_base64}" />
</svg>
"""
    output_svg.write_text(svg_content, encoding='utf-8')

def convert_rendered_pdf_page(temp_page, output_page, target_ext):
    """Convert a rendered PNG page into the requested output format."""
    if target_ext == 'png':
        shutil.move(str(temp_page), str(output_page))
        return None

    if target_ext == 'svg':
        write_embedded_svg_from_png(temp_page, output_page)
        return None

    if not check_tool_available('convert'):
        return f"Converting PDF pages to .{target_ext} requires ImageMagick"

    convert_cmd = ['convert', str(temp_page)]
    if target_ext == 'ico':
        convert_cmd.extend(['-resize', '256x256'])
    convert_cmd.append(str(output_page))

    if DEBUG:
        print(f"[DEBUG] Running: {' '.join(convert_cmd)}")

    convert_result = subprocess.run(
        convert_cmd,
        capture_output=True,
        text=True,
        timeout=120
    )
    if convert_result.returncode != 0 or not output_page.exists():
        return convert_result.stderr.strip() if convert_result.stderr else "ImageMagick did not create the output file"
    return None

def get_file_category(extension, filename=''):
    """Determine the category of a file based on its extension"""
    ext = extension.lower().lstrip('.')

    if ext in DOCUMENT_FORMATS:
        return 'document', ext
    elif ext in IMAGE_FORMATS:
        return 'image', ext
    elif ext in AUDIO_FORMATS:
        return 'audio', ext
    elif ext in VIDEO_FORMATS:
        return 'video', ext
    elif ext in ARCHIVE_FORMATS:
        return 'archive', ext
    elif ext in DATA_FORMATS:
        return 'data', ext
    else:
        return None, None

def convert_document(source, target_ext, source_ext):
    """Convert document formats using LibreOffice or Pandoc"""
    target_file = source.with_suffix(f'.{target_ext}')

    # Try LibreOffice first for office formats
    if target_ext in ['pdf', 'docx', 'doc', 'xlsx', 'xls', 'csv', 'pptx', 'ppt', 'odt', 'ods', 'odp', 'rtf', 'html']:
        if check_tool_available('libreoffice'):
            try:
                # For CSV, use filter with separator options
                if target_ext == 'csv':
                    cmd = [
                        'libreoffice',
                        '--headless',
                        '--convert-to', 'csv:Text - txt - csv (StarCalc):44,34,76',
                        '--outdir', str(source.parent),
                        str(source)
                    ]
                else:
                    cmd = [
                        'libreoffice',
                        '--headless',
                        '--convert-to', target_ext,
                        '--outdir', str(source.parent),
                        str(source)
                    ]

                if DEBUG:
                    print(f"[DEBUG] Running: {' '.join(cmd)}")

                result = subprocess.run(cmd, capture_output=True, text=True, timeout=60)

                if result.returncode == 0 and target_file.exists():
                    return True, str(target_file)
                else:
                    if DEBUG:
                        print(f"[DEBUG] LibreOffice failed: {result.stderr}")
            except subprocess.TimeoutExpired:
                print("⚠️  Conversion timed out (60s limit)")
                return False, "Timeout"
            except Exception as e:
                if DEBUG:
                    print(f"[DEBUG] LibreOffice error: {e}")

    # Try Pandoc for text-based formats
    if target_ext in ['md', 'html', 'txt', 'docx', 'pdf', 'epub', 'rtf'] and source_ext in ['md', 'html', 'txt', 'docx', 'rtf']:
        if check_tool_available('pandoc'):
            try:
                cmd = [
                    'pandoc',
                    str(source),
                    '-o', str(target_file)
                ]

                if DEBUG:
                    print(f"[DEBUG] Running: {' '.join(cmd)}")

                result = subprocess.run(cmd, capture_output=True, text=True, timeout=60)

                if result.returncode == 0 and target_file.exists():
                    return True, str(target_file)
                else:
                    if DEBUG:
                        print(f"[DEBUG] Pandoc failed: {result.stderr}")
            except subprocess.TimeoutExpired:
                print("⚠️  Conversion timed out (60s limit)")
                return False, "Timeout"
            except Exception as e:
                if DEBUG:
                    print(f"[DEBUG] Pandoc error: {e}")

    return False, "No suitable converter found"

def convert_pdf(source, target_ext, source_ext):
    """
    Convert PDF to MD, TXT, or HTML using pdftotext (primary) with markitdown fallback.
    Prioritizes pdftotext for speed and reliability, falling back to markitdown on failure.
    """
    target_file = source.with_suffix(f'.{target_ext}')
    used_pdftotext = False

    # ===== PRIMARY METHOD: pdftotext =====
    if check_tool_available('pdftotext'):
        try:
            print("⏳ Extracting text from PDF using pdftotext...")
            cmd = ['pdftotext', '-layout', '-enc', 'UTF-8', str(source), '-']

            if DEBUG:
                print(f"[DEBUG] Running: {' '.join(cmd)}")

            # Run pdftotext with 20-second timeout
            result = subprocess.run(cmd, capture_output=True, text=True, timeout=20)

            # Check for successful execution WITHOUT stderr warnings
            if result.returncode == 0 and result.stdout.strip() and not result.stderr.strip():
                used_pdftotext = True
                extracted_content = result.stdout

                if DEBUG:
                    print(f"[DEBUG] pdftotext succeeded, extracted {len(extracted_content)} characters")

                # Step: Generate output based on target format (pdftotext handles Hebrew correctly)
                if target_ext == 'md':
                    # Save as markdown
                    with open(target_file, 'w', encoding='utf-8') as f:
                        f.write(extracted_content)
                    print(f"✅ Conversion successful using pdftotext")
                    return True, str(target_file)

                elif target_ext == 'txt':
                    # Save as plain text with RTL marker for proper Hebrew display
                    rtl_mark = '\u200F'  # RIGHT-TO-LEFT MARK
                    with open(target_file, 'w', encoding='utf-8') as f:
                        f.write(rtl_mark + extracted_content)
                    print(f"✅ Conversion successful using pdftotext")
                    return True, str(target_file)

                elif target_ext == 'html':
                    # Generate smart RTL/LTR HTML (pdftotext preserves Hebrew correctly)
                    html_content = generate_html_with_smart_rtl(extracted_content, title=source.stem)
                    with open(target_file, 'w', encoding='utf-8') as f:
                        f.write(html_content)
                    print(f"✅ Conversion successful using pdftotext")
                    return True, str(target_file)

            else:
                # pdftotext failed or had warnings - silently fallback to markitdown
                if DEBUG:
                    if result.returncode == 0 and result.stdout.strip() and result.stderr.strip():
                        print(f"[DEBUG] pdftotext had warnings, falling back to markitdown")
                        print(f"[DEBUG] stderr: {result.stderr[:500]}")
                    elif result.returncode != 0:
                        print(f"[DEBUG] pdftotext failed (exit code {result.returncode}), falling back to markitdown")
                    else:
                        print(f"[DEBUG] pdftotext produced no output, falling back to markitdown")
                # No warning message to user, continue to markitdown fallback

        except subprocess.TimeoutExpired:
            # pdftotext timed out after 20 seconds - silently fallback
            if DEBUG:
                print(f"[DEBUG] pdftotext timed out after 20 seconds, falling back to markitdown")
            # No warning message to user, continue to markitdown fallback

        except Exception as e:
            # Any other error with pdftotext - silently fallback
            if DEBUG:
                print(f"[DEBUG] pdftotext error: {e}, falling back to markitdown")
            # No warning message to user, continue to markitdown fallback

    else:
        if DEBUG:
            print(f"[DEBUG] pdftotext not available, using markitdown")

    # ===== FALLBACK METHOD: markitdown =====
    if not used_pdftotext:
        if not check_tool_available('markitdown'):
            return False, "pdftotext failed and markitdown not installed (pip3 install --break-system-packages markitdown)"

        try:
            # Step 1: Use markitdown to convert PDF to markdown
            print("⏳ Extracting text from PDF using markitdown...")
            cmd = ['markitdown', str(source)]

            if DEBUG:
                print(f"[DEBUG] Running: {' '.join(cmd)}")

            result = subprocess.run(cmd, capture_output=True, text=True, timeout=600)

            if result.returncode != 0:
                return False, f"markitdown error: {result.stderr}"

            # Step 2: Apply Hebrew fixing to the extracted content (markitdown reverses Hebrew)
            markdown_content = result.stdout

            if DEBUG:
                print(f"[DEBUG] Applying Hebrew text fixing for markitdown output...")

            # Fix reversed Hebrew characters line by line
            lines = markdown_content.split('\n')
            fixed_lines = [reverse_hebrew_text(line) for line in lines]
            fixed_content = '\n'.join(fixed_lines)

            # Step 3: Generate output based on target format
            if target_ext == 'md':
                # Save as markdown
                with open(target_file, 'w', encoding='utf-8') as f:
                    f.write(fixed_content)
                print(f"✅ Conversion successful using markitdown")
                return True, str(target_file)

            elif target_ext == 'txt':
                # Save as plain text with RTL marker
                rtl_mark = '\u200F'  # RIGHT-TO-LEFT MARK for proper text editor display
                with open(target_file, 'w', encoding='utf-8') as f:
                    f.write(rtl_mark + fixed_content)
                print(f"✅ Conversion successful using markitdown")
                return True, str(target_file)

            elif target_ext == 'html':
                # Generate smart RTL/LTR HTML
                html_content = generate_html_with_smart_rtl(fixed_content, title=source.stem)
                with open(target_file, 'w', encoding='utf-8') as f:
                    f.write(html_content)
                print(f"✅ Conversion successful using markitdown")
                return True, str(target_file)

            else:
                return False, f"Unsupported PDF target format: {target_ext}"

        except subprocess.TimeoutExpired:
            return False, "PDF conversion timed out (600s limit)"
        except Exception as e:
            if DEBUG:
                print(f"[DEBUG] PDF conversion error: {e}")
            return False, str(e)

def convert_image(source, target_ext, source_ext):
    """Convert image formats using ImageMagick"""
    if not check_tool_available('convert'):
        return False, "ImageMagick not installed (apt install imagemagick)"

    target_file = source.with_suffix(f'.{target_ext}')

    try:
        # Special handling for animated GIF input - extract only first frame
        if source_ext == 'gif':
            cmd = ['convert', f'{str(source)}[0]', str(target_file)]
        else:
            cmd = ['convert', str(source), str(target_file)]

        if DEBUG:
            print(f"[DEBUG] Running: {' '.join(cmd)}")

        result = subprocess.run(cmd, capture_output=True, text=True, timeout=60)

        if result.returncode == 0 and target_file.exists():
            return True, str(target_file)
        else:
            return False, f"ImageMagick error: {result.stderr}"
    except subprocess.TimeoutExpired:
        return False, "Timeout"
    except Exception as e:
        return False, str(e)

def convert_audio(source, target_ext, source_ext):
    """Convert audio formats using FFmpeg"""
    if not check_tool_available('ffmpeg'):
        return False, "FFmpeg not installed (apt install ffmpeg)"

    if target_ext in DECODE_ONLY_AUDIO:
        return False, (f"'{target_ext}' is read-only: FFmpeg has no {target_ext.upper()} "
                       f"encoder. Use it as a source, not a target (try mp3, m4a or wav)")

    target_file = source.with_suffix(f'.{target_ext}')

    try:
        # Quality settings based on format
        cmd = ['ffmpeg', '-i', str(source), '-y']

        # Add quality parameters
        if target_ext == 'mp3':
            cmd.extend(['-codec:a', 'libmp3lame', '-q:a', '2'])
        elif target_ext == 'ogg':
            cmd.extend(['-codec:a', 'libvorbis', '-q:a', '6'])
        elif target_ext == 'flac':
            cmd.extend(['-codec:a', 'flac'])
        elif target_ext == 'aac':
            cmd.extend(['-codec:a', 'aac', '-b:a', '192k'])

        cmd.append(str(target_file))

        if DEBUG:
            print(f"[DEBUG] Running: {' '.join(cmd)}")

        result = subprocess.run(cmd, capture_output=True, text=True, timeout=300)

        if result.returncode == 0 and target_file.exists():
            return True, str(target_file)
        else:
            return False, f"FFmpeg error: {result.stderr.split('Error')[-1] if 'Error' in result.stderr else 'Conversion failed'}"
    except subprocess.TimeoutExpired:
        return False, "Timeout (5 min limit)"
    except Exception as e:
        return False, str(e)

def convert_video(source, target_ext, source_ext):
    """Convert video formats using FFmpeg"""
    if not check_tool_available('ffmpeg'):
        return False, "FFmpeg not installed (apt install ffmpeg)"

    target_file = source.with_suffix(f'.{target_ext}')

    # Special case: video to audio extraction
    if target_ext in AUDIO_FORMATS:
        return convert_audio(source, target_ext, source_ext)

    try:
        # Basic conversion with codec selection
        cmd = ['ffmpeg', '-i', str(source), '-y']

        # Codec settings based on target format
        if target_ext == 'mp4':
            cmd.extend(['-codec:v', 'libx264', '-crf', '23', '-codec:a', 'aac', '-b:a', '192k'])
        elif target_ext == 'webm':
            cmd.extend(['-codec:v', 'libvpx-vp9', '-crf', '30', '-codec:a', 'libopus'])
        elif target_ext == 'mkv':
            cmd.extend(['-codec:v', 'copy', '-codec:a', 'copy'])

        cmd.append(str(target_file))

        if DEBUG:
            print(f"[DEBUG] Running: {' '.join(cmd)}")

        print(f"⏳ Converting video... (this may take a while)")
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=600)

        if result.returncode == 0 and target_file.exists():
            return True, str(target_file)
        else:
            return False, f"FFmpeg error: {result.stderr.split('Error')[-1] if 'Error' in result.stderr else 'Conversion failed'}"
    except subprocess.TimeoutExpired:
        return False, "Timeout (10 min limit)"
    except Exception as e:
        return False, str(e)

def convert_video_to_gif(source, target_ext, source_ext):
    """Convert video to animated GIF (first 10 seconds only)"""
    if not check_tool_available('ffmpeg'):
        return False, "FFmpeg not installed (apt install ffmpeg)"

    target_file = source.with_suffix(f'.{target_ext}')

    try:
        # Generate color palette for better quality GIF
        palette_file = source.parent / f"{source.stem}_palette.png"
        
        # Create palette from first 10 seconds
        palette_cmd = [
            'ffmpeg', '-i', str(source),
            '-t', '10',  # First 10 seconds only
            '-vf', 'fps=10,scale=480:-1:flags=lanczos,palettegen',
            '-y', str(palette_file)
        ]
        
        if DEBUG:
            print(f"[DEBUG] Generating palette: {' '.join(palette_cmd)}")
        
        result = subprocess.run(palette_cmd, capture_output=True, text=True, timeout=60)
        
        if result.returncode != 0 or not palette_file.exists():
            return False, "Failed to generate color palette"
        
        # Convert to GIF using the palette (first 10 seconds)
        gif_cmd = [
            'ffmpeg', '-i', str(source),
            '-i', str(palette_file),
            '-t', '10',  # First 10 seconds only
            '-lavfi', 'fps=10,scale=480:-1:flags=lanczos [x]; [x][1:v] paletteuse',
            '-y', str(target_file)
        ]
        
        if DEBUG:
            print(f"[DEBUG] Creating GIF: {' '.join(gif_cmd)}")
        
        print(f"⏳ Converting video to animated GIF (first 10 seconds)...")
        result = subprocess.run(gif_cmd, capture_output=True, text=True, timeout=120)
        
        # Clean up palette file
        palette_file.unlink(missing_ok=True)
        
        if result.returncode == 0 and target_file.exists():
            return True, str(target_file)
        else:
            return False, f"FFmpeg error: {result.stderr.split('Error')[-1] if 'Error' in result.stderr else 'Conversion failed'}"
            
    except subprocess.TimeoutExpired:
        palette_file.unlink(missing_ok=True)
        return False, "Timeout (2 min limit)"
    except Exception as e:
        palette_file.unlink(missing_ok=True)
        return False, str(e)

def convert_image_to_document(source, target_ext, source_ext):
    """Convert image to document format (PDF, HTML, etc.)"""
    target_file = source.with_suffix(f'.{target_ext}')

    if target_ext == 'pdf':
        # Try img2pdf first (better quality, smaller size)
        if check_tool_available('img2pdf'):
            try:
                # img2pdf ignores EXIF orientation and sizes the page from the
                # raw pixel data, which cuts off photos taken in portrait mode.
                # Bake the EXIF rotation into the pixels first so page size matches.
                img2pdf_source = source
                oriented_temp = None
                try:
                    from PIL import Image, ImageOps
                    with Image.open(source) as img:
                        oriented = ImageOps.exif_transpose(img)
                        if oriented is not img:
                            oriented_temp = source.with_name(f"{source.stem}_oriented{source.suffix}")
                            oriented.save(oriented_temp)
                            img2pdf_source = oriented_temp
                except Exception as e:
                    if DEBUG:
                        print(f"[DEBUG] EXIF auto-orient skipped: {e}")

                cmd = ['img2pdf', str(img2pdf_source), '-o', str(target_file)]
                if DEBUG:
                    print(f"[DEBUG] Running: {' '.join(cmd)}")

                result = subprocess.run(cmd, capture_output=True, text=True, timeout=60)

                if oriented_temp:
                    oriented_temp.unlink(missing_ok=True)

                if result.returncode == 0 and target_file.exists():
                    return True, str(target_file)
            except Exception as e:
                if DEBUG:
                    print(f"[DEBUG] img2pdf failed: {e}")

        # Fallback to ImageMagick convert
        if check_tool_available('convert'):
            try:
                cmd = ['convert', str(source), str(target_file)]
                if DEBUG:
                    print(f"[DEBUG] Running: {' '.join(cmd)}")

                result = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
                if result.returncode == 0 and target_file.exists():
                    return True, str(target_file)
                else:
                    return False, f"ImageMagick error: {result.stderr}"
            except Exception as e:
                return False, str(e)

        return False, "No PDF converter found (install img2pdf or imagemagick)"

    elif target_ext == 'html':
        # Create HTML with embedded image
        try:
            import base64
            with open(source, 'rb') as img_file:
                img_data = base64.b64encode(img_file.read()).decode('utf-8')

            # Determine MIME type
            mime_types = {
                'jpg': 'image/jpeg', 'jpeg': 'image/jpeg',
                'png': 'image/png', 'gif': 'image/gif',
                'bmp': 'image/bmp', 'webp': 'image/webp',
                'svg': 'image/svg+xml', 'ico': 'image/x-icon'
            }
            mime_type = mime_types.get(source_ext, 'image/png')

            safe_name = html.escape(source.name)
            html_content = f'''<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{safe_name}</title>
    <style>
        body {{ margin: 0; display: flex; justify-content: center; align-items: center; min-height: 100vh; background: #f0f0f0; }}
        img {{ max-width: 100%; max-height: 100vh; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }}
    </style>
</head>
<body>
    <img src="data:{mime_type};base64,{img_data}" alt="{safe_name}">
</body>
</html>'''

            with open(target_file, 'w') as f:
                f.write(html_content)

            return True, str(target_file)
        except Exception as e:
            return False, f"HTML creation error: {e}"

    return False, f"Image to {target_ext} not supported (only PDF and HTML work)"

def convert_document_to_image(source, target_ext, source_ext, pdf_all_pages=False):
    """Convert document to image format (PDF to PNG/JPG, etc.)"""
    target_file = source.with_suffix(f'.{target_ext}')

    # PDF to image conversion
    if source_ext == 'pdf':
        if pdf_all_pages:
            if not check_tool_available('pdftoppm'):
                return False, "PDF to image requires pdftoppm (install poppler-utils)"

            try:
                output_dir = get_pdf_page_output_dir(source)
            except RuntimeError as e:
                return False, str(e)

            for existing_file in output_dir.glob(f"{source.stem}-page-*.{target_ext}"):
                existing_file.unlink(missing_ok=True)

            with tempfile.TemporaryDirectory(prefix=f"{source.stem}-pages-") as temp_dir_name:
                temp_dir = Path(temp_dir_name)
                temp_prefix = str(temp_dir / f"{source.stem}-page")
                cmd = ['pdftoppm', '-png', str(source), temp_prefix]

                if DEBUG:
                    print(f"[DEBUG] Running: {' '.join(cmd)}")

                result = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
                temp_pages = sorted(
                    temp_dir.glob(f"{source.stem}-page-*.png"),
                    key=get_page_number_from_path
                )

                if result.returncode != 0 or not temp_pages:
                    error_detail = result.stderr.strip() if result.stderr else "pdftoppm did not create page images"
                    return False, f"pdftoppm error: {error_detail}"

                for temp_page in temp_pages:
                    page_number = get_page_number_from_path(temp_page)
                    output_page = output_dir / f"{source.stem}-page-{page_number}.{target_ext}"
                    error_detail = convert_rendered_pdf_page(temp_page, output_page, target_ext)
                    if error_detail:
                        if target_ext in ['svg', 'ico']:
                            return False, f"Failed to create .{target_ext} page output: {error_detail}"
                        return False, f"ImageMagick error: {error_detail}"

            return True, str(output_dir)

        # Try pdftoppm first (better quality)
        if check_tool_available('pdftoppm'):
            try:
                temp_prefix = str(target_file.with_suffix(''))
                format_map = {
                    'png': 'png',
                    'jpg': 'jpeg', 'jpeg': 'jpeg',
                    'tiff': 'tiff', 'tif': 'tiff'
                }
                output_format = format_map.get(target_ext, 'png')

                cmd = ['pdftoppm', '-' + output_format, '-singlefile', str(source), temp_prefix]
                if DEBUG:
                    print(f"[DEBUG] Running: {' '.join(cmd)}")

                result = subprocess.run(cmd, capture_output=True, text=True, timeout=60)

                # pdftoppm creates file with extension
                created_file = Path(f"{temp_prefix}.{output_format if output_format != 'jpeg' else 'jpg'}")
                if result.returncode == 0 and created_file.exists():
                    if created_file != target_file:
                        created_file.rename(target_file)
                    return True, str(target_file)
            except Exception as e:
                if DEBUG:
                    print(f"[DEBUG] pdftoppm failed: {e}")

        # Fallback to ImageMagick convert
        if check_tool_available('convert'):
            try:
                cmd = ['convert', '-density', '300', f'{str(source)}[0]', str(target_file)]
                if DEBUG:
                    print(f"[DEBUG] Running: {' '.join(cmd)}")

                result = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
                if result.returncode == 0 and target_file.exists():
                    return True, str(target_file)
                else:
                    return False, f"ImageMagick error: {result.stderr}"
            except Exception as e:
                return False, str(e)

        return False, "No PDF to image converter found (install poppler-utils or imagemagick)"

    # Other document formats: convert to PDF first, then to image
    else:
        if check_tool_available('libreoffice'):
            try:
                cmd = [
                    'libreoffice',
                    '--headless',
                    '--convert-to', 'pdf',
                    '--outdir', str(source.parent),
                    str(source)
                ]

                if DEBUG:
                    print(f"[DEBUG] Converting to PDF first: {' '.join(cmd)}")

                result = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
                actual_temp_pdf = source.with_suffix('.pdf')

                if result.returncode == 0 and actual_temp_pdf.exists():
                    # Now convert PDF to image
                    success, result_path = convert_document_to_image(actual_temp_pdf, target_ext, 'pdf')
                    # Clean up temp PDF
                    try:
                        actual_temp_pdf.unlink()
                    except:
                        pass
                    return success, result_path
            except Exception as e:
                if DEBUG:
                    print(f"[DEBUG] Document to PDF failed: {e}")

        return False, f"Cannot convert {source_ext} to image (LibreOffice not available)"

def convert_video_to_image(source, target_ext, source_ext):
    """Extract frame from video as image"""
    if not check_tool_available('ffmpeg'):
        return False, "FFmpeg not installed (apt install ffmpeg)"

    target_file = source.with_suffix(f'.{target_ext}')

    try:
        cmd = [
            'ffmpeg', '-i', str(source),
            '-ss', '00:00:01',
            '-vframes', '1',
            '-y',
            str(target_file)
        ]

        if DEBUG:
            print(f"[DEBUG] Running: {' '.join(cmd)}")

        result = subprocess.run(cmd, capture_output=True, text=True, timeout=60)

        if result.returncode == 0 and target_file.exists():
            return True, str(target_file)
        else:
            return False, f"FFmpeg error: {result.stderr.split('Error')[-1] if 'Error' in result.stderr else 'Frame extraction failed'}"
    except subprocess.TimeoutExpired:
        return False, "Timeout"
    except Exception as e:
        return False, str(e)

def convert_data(source: Path, target_ext: str, source_ext: str):
    """Convert data formats (JSON, XML, CSV, YAML) in-process."""
    import json
    import csv as csv_mod
    import re
    import xml.etree.ElementTree as ET
    import xml.dom.minidom

    target_file = source.with_suffix(f'.{target_ext}')

    def read_json(path):
        with open(path, 'r', encoding='utf-8') as f:
            return json.load(f)

    def read_xml(path):
        tree = ET.parse(path)
        root = tree.getroot()
        if len(root) == 0:
            return {root.tag: root.text}
        result = []
        for child in root:
            item = {subchild.tag: subchild.text for subchild in child}
            if item:
                result.append(item)
        return result if result else {child.tag: child.text for child in root}

    def read_csv(path):
        with open(path, 'r', encoding='utf-8') as f:
            return list(csv_mod.DictReader(f))

    def read_yaml(path):
        try:
            import yaml
            with open(path, 'r', encoding='utf-8') as f:
                return yaml.safe_load(f)
        except ImportError:
            raise RuntimeError("PyYAML not installed (pip3 install --break-system-packages pyyaml)")

    def sanitize_tag(name):
        name = re.sub(r'[^a-zA-Z0-9_.-]', '_', str(name))
        if name and (name[0].isdigit() or name[0] in '.-'):
            name = 'item_' + name
        return name or 'item'

    def write_json(data, path):
        with open(path, 'w', encoding='utf-8') as f:
            json.dump(data, f, indent=2, ensure_ascii=False)

    def write_xml(data, path):
        root = ET.Element("root")
        if isinstance(data, list):
            for item in data:
                item_elem = ET.SubElement(root, "item")
                if isinstance(item, dict):
                    for key, value in item.items():
                        child = ET.SubElement(item_elem, sanitize_tag(key))
                        child.text = str(value) if value is not None else ''
                else:
                    item_elem.text = str(item) if item is not None else ''
        elif isinstance(data, dict):
            for key, value in data.items():
                child = ET.SubElement(root, sanitize_tag(key))
                child.text = str(value) if value is not None else ''
        xml_bytes = ET.tostring(root, encoding='utf-8')
        pretty = xml.dom.minidom.parseString(xml_bytes).toprettyxml(indent="  ", encoding='utf-8')
        with open(path, 'wb') as f:
            f.write(pretty)

    def write_csv(data, path):
        if isinstance(data, dict):
            data = [data]
        if not data:
            return
        with open(path, 'w', encoding='utf-8', newline='') as f:
            writer = csv_mod.DictWriter(f, fieldnames=data[0].keys())
            writer.writeheader()
            writer.writerows(data)

    def write_yaml(data, path):
        try:
            import yaml
            with open(path, 'w', encoding='utf-8') as f:
                yaml.dump(data, f, allow_unicode=True, default_flow_style=False)
        except ImportError:
            raise RuntimeError("PyYAML not installed (pip3 install --break-system-packages pyyaml)")

    try:
        if source_ext == 'json':
            data = read_json(source)
        elif source_ext == 'xml':
            data = read_xml(source)
        elif source_ext == 'csv':
            data = read_csv(source)
        elif source_ext in ('yaml', 'yml'):
            data = read_yaml(source)
        else:
            return False, f"Unsupported source format: {source_ext}"

        if target_ext == 'json':
            write_json(data, target_file)
        elif target_ext == 'xml':
            write_xml(data, target_file)
        elif target_ext == 'csv':
            write_csv(data, target_file)
        elif target_ext in ('yaml', 'yml'):
            write_yaml(data, target_file)
        else:
            return False, f"Unsupported target format: {target_ext}"

        if target_file.exists():
            return True, str(target_file)
        return False, "Conversion produced no output"

    except Exception as e:
        if DEBUG:
            import traceback
            traceback.print_exc()
        return False, str(e)
def convert_archive(source, target_ext, source_ext):
    """Convert archive formats by extracting and recompressing"""
    import tempfile

    # Get base name without any archive extensions
    base_name = source.stem

    # Determine target filename
    target_file = source.parent / f"{base_name}.{target_ext}"

    # Create temp directory for extraction
    temp_dir = Path(tempfile.mkdtemp(prefix='con_archive_'))

    try:
        # Extract source archive
        print(f"⏳ Extracting {source.name}...")
        extract_success = _extract_archive(source, temp_dir, source_ext)
        if not extract_success:
            shutil.rmtree(temp_dir, ignore_errors=True)
            return False, f"Failed to extract {source_ext} archive"

        # Create target archive
        print(f"⏳ Creating {target_ext} archive...")
        compress_success = _create_archive(temp_dir, target_file, target_ext)
        if not compress_success:
            shutil.rmtree(temp_dir, ignore_errors=True)
            if target_ext == 'iso':
                return False, f"ISO creation requires genisoimage or mkisofs (apt install genisoimage)"
            return False, f"Failed to create {target_ext} archive"

        # Clean up temp directory
        shutil.rmtree(temp_dir, ignore_errors=True)

        if target_file.exists():
            return True, str(target_file)
        else:
            return False, "Archive created but file not found"

    except Exception as e:
        # Clean up on error
        shutil.rmtree(temp_dir, ignore_errors=True)
        return False, f"Archive conversion error: {str(e)}"

def _check_archive_safe(source: Path, source_ext: str) -> bool:
    """Pre-extraction check for path traversal (zip slip protection)."""
    try:
        if source_ext == 'zip':
            cmd = ['unzip', '-l', str(source)]
        elif source_ext == 'rar':
            cmd = ['unrar', 'l', str(source)]
        elif source_ext in ('7z', 'iso'):
            cmd = ['7z', 'l', str(source)]
        elif source_ext == 'tar':
            cmd = ['tar', 'tf', str(source)]
        else:
            return True

        result = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
        if result.returncode != 0:
            return True  # can't list contents, proceed

        for line in result.stdout.splitlines():
            stripped = line.strip()
            if '../' in stripped or stripped.startswith('/'):
                return False
        return True
    except Exception:
        return True


def _extract_archive(source, temp_dir, source_ext):
    """Extract archive to temp directory using native tool for source format"""
    if not _check_archive_safe(source, source_ext):
        if DEBUG:
            print(f"[DEBUG] Archive rejected: path traversal detected")
        return False

    try:
        if source_ext == 'zip':
            cmd = ['unzip', '-q', str(source), '-d', str(temp_dir)]
        elif source_ext == 'rar':
            cmd = ['unrar', 'x', '-y', str(source), str(temp_dir) + '/']
        elif source_ext == '7z':
            cmd = ['7z', 'x', f'-o{temp_dir}', '-y', str(source)]
        elif source_ext == 'tar':
            cmd = ['tar', 'xf', str(source), '-C', str(temp_dir)]
        elif source_ext == 'iso':
            cmd = ['7z', 'x', f'-o{temp_dir}', '-y', str(source)]
        else:
            return False

        if DEBUG:
            print(f"[DEBUG] Extract: {' '.join(cmd)}")

        result = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
        return result.returncode == 0

    except Exception as e:
        if DEBUG:
            print(f"[DEBUG] Extract error: {e}")
        return False

def _create_archive(temp_dir, target_file, target_ext):
    """Create archive from temp directory contents using native tool for target format"""
    try:
        items = list(temp_dir.iterdir())
        if not items:
            return False

        item_names = [item.name for item in items]
        target_file_abs = str(target_file.resolve())

        if target_ext == 'zip':
            cmd = ['zip', '-r', '-q', target_file_abs] + item_names
        elif target_ext == 'rar':
            cmd = ['rar', 'a', '-r', '-ep1', target_file_abs] + item_names
        elif target_ext == '7z':
            cmd = ['7z', 'a', target_file_abs] + item_names
        elif target_ext == 'tar':
            cmd = ['tar', 'cf', target_file_abs] + item_names
        elif target_ext == 'iso':
            if DEBUG:
                print("[DEBUG] ISO creation requires genisoimage or mkisofs")
            if check_tool_available('genisoimage'):
                cmd = ['genisoimage', '-o', target_file_abs, '-R', '-J'] + item_names
            elif check_tool_available('mkisofs'):
                cmd = ['mkisofs', '-o', target_file_abs, '-R', '-J'] + item_names
            else:
                return False
        else:
            return False

        if DEBUG:
            print(f"[DEBUG] Create: {' '.join(cmd)}")

        result = subprocess.run(cmd, capture_output=True, text=True, timeout=300, cwd=str(temp_dir))

        if DEBUG and result.returncode != 0:
            print(f"[DEBUG] Create failed - returncode: {result.returncode}")
            print(f"[DEBUG] stderr: {result.stderr}")
            print(f"[DEBUG] stdout: {result.stdout}")

        return result.returncode == 0

    except Exception as e:
        if DEBUG:
            print(f"[DEBUG] Create archive error: {e}")
        return False

